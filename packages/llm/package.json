    "@effect/platform-node": "catalog:",
    "@opencode-ai/http-recorder": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  },
  "dependencies": {
    "@smithy/eventstream-codec": "4.2.14",
    "@smithy/util-utf8": "4.2.2",
    "aws4fetch": "1.0.20",
