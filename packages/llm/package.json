      "default": "./src/provider.ts"
    },
    "./provider-quota": {
      "types": "./dist/provider-quota.d.ts",
      "default": "./src/provider-quota.ts"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./src/providers/index.ts"
    },
    "./providers/amazon-bedrock": {
      "types": "./dist/providers/amazon-bedrock.d.ts",
      "default": "./src/providers/amazon-bedrock.ts"
