{
  "name": "@opencode-ai/provider-cursor",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./provider": "./dist/index.js",
    "./server": "./dist/server.js",
    "./adapter": "./dist/adapter.js"
  },
  "files": [
    "dist",
    "src/upstream/LICENSE",
    "src/upstream/PROVENANCE.md"
  ],
  "opencode": {
    "api": {
      "provider": 1,
      "server": 2
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/server.ts ./src/adapter.ts --outdir ./dist --target node --splitting",
    "typecheck": "tsgo --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.15",
    "protobufjs": "^7.6.5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.17.7"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.0",
    "@typescript/native-preview": "7.0.0-dev.20251207.1"
  }
}
